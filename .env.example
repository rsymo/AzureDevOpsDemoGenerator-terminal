# Example configuration file for Azure DevOps Demo Generator
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# Azure DevOps Organization name
# Example: ADO_ORG=myorganization
ADO_ORG=

# Personal Access Token (PAT)
# Get from: https://dev.azure.com/[your-org]/_usersSettings/tokens
# Example: ADO_PAT=abcdef1234567890...
ADO_PAT=

# Default email for projects (optional)
# Example: ADO_EMAIL=admin@company.com
ADO_EMAIL=

# Usage:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your values
# 3. Load variables: source .env
# 4. Run the script: ./load-ado-sample-data.sh
