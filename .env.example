# Example configuration file for Azure DevOps Template Importer
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# Azure DevOps Organization name
# Example: ADO_ORG=myorganization
ADO_ORG=

# Authentication: Uses Azure CLI (more secure than PAT)
# Run 'az login' before using the script

# Usage:
# 1. Install Azure CLI: https://aka.ms/azure-cli
# 2. Login: az login
# 3. Copy this file: cp .env.example .env
# 4. Fill in ADO_ORG in .env
# 5. Load variables: source .env
# 6. Run the script: ./import-ado-template.sh -n "ProjectName" -t "TemplateName" -y
